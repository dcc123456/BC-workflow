      {
        "data": {
          "blockId": "javascript-code",
          "code": "const topLikedNoteSelectors = (() => {\n  const container = document.querySelector('div.feeds-container') || document.body;\n\n  // “1.2万” / “3456” / “1w” -> 数字\n  const parseCount = (text) => {\n    if (!text) return 0;\n    const m = String(text).replace(/\\s+/g, '').match(/([\\d.]+)(万|w|W|k|K)?/);\n    if (!m) return 0;\n    const n = parseFloat(m[1]);\n    if (isNaN(n)) return 0;\n    const unit = m[2];\n    if (unit === '万' || unit === 'w' || unit === 'W') return Math.round(n * 10000);\n    if (unit === 'k' || unit === 'K') return Math.round(n * 1000);\n    return Math.round(n);\n  };\n\n  // 每条笔记记录：唯一 id（来自 /explore/<id> 链接）+ 标题 + 点赞数\n  const notes = Array.from(container.querySelectorAll('section.note-item')).map((card) => {\n    const link = card.querySelector('a[href*=\"/explore/\"]');\n    const href = link ? link.getAttribute('href') : '';\n    const idMatch = href.match(/\\/explore\\/([0-9a-zA-Z]+)/);\n    const titleEl = card.querySelector('.footer .title span') || card.querySelector('.title span') || card.querySelector('a.title');\n    return {\n      noteId: idMatch ? idMatch[1] : '',\n      title: titleEl ? titleEl.textContent.trim() : '',\n      likes: parseCount((card.querySelector('.like-wrapper .count') || card.querySelector('.count') || {}).textContent),\n    };\n  }).filter((n) => n.noteId);\n\n  // 按点赞数降序，取前 10 条\n  notes.sort((a, b) => b.likes - a.likes);\n\n  // 用笔记唯一 id 定位卡片，不再用 nth-child 位置：滚动 / 懒加载 / 重排都不会指向别的笔记\n  const topLikedNoteSelectors = notes.slice(0, 3).map((n) => `section.note-item:has(a[href*=\"${n.noteId}\"])`);\n  automaSetVariable('topLikedNoteSelectors', topLikedNoteSelectors)  \n  return topLikedNoteSelectors\n})();",
          "context": "page",
          "description": "",
          "disableBlock": false,
          "everyNewTab": false,
          "label": "按笔记唯一标识生成点赞最高笔记的选择器数组",
          "preloadScripts": [],
          "runBeforeLoad": false,
          "timeout": 5000
        },
